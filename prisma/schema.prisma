generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ItemType {
  LESSON
  QUIZ
  ARTICLE
}

enum Track {
  ENTREPRENEURSHIP_ECONOMICS
  DEVELOPMENT_ECONOMICS
  BEHAVIORAL_ECONOMICS
}

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String?   @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  createdAt             DateTime  @default(now())
  deletedAt             DateTime?
  twoFactorSecret       String?
  isTwoFactorEnabled    Boolean   @default(false)
  lockedUntil           DateTime?
  failedLoginAttempts   Int       @default(0)
  lessonsCompleted      Int       @default(0)
  lastLessonCompletedAt DateTime?

  activeTrack        Track?
  trackProgress      TrackProgress[]
  progress           UserProgress?
  quizAttempts       QuizAttempt[]
  mistakeReviews     MistakeReview[]
  agendaHistory      AgendaCompletion[]
  dailyCompletions   DailyCompletion[]
  completedLessons   CompletedLesson[]
  quizResults        QuizResult[]
  accounts           Account[]
  sessions           Session[]
  notes              Note[]
  bookmarks          Bookmark[]
  leaderboardRank    LeaderboardRank?
  duelRuns           DuelRun[]
  duelRating         PlayerRating?
  dailyAnswers       DailyAnswer[]
  staff              Staff?
  hostedCompetitions Competition[]       @relation("CompetitionHost")
  competitionPlays   CompetitionPlayer[]
  competitionAnswers CompetitionAnswer[]
  authoredProblems   Problem[]           @relation("ProblemAuthor")

  @@index([lessonsCompleted, lastLessonCompletedAt, createdAt])
}

model DailyCompletion {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  normalizedDate DateTime
  createdAt      DateTime @default(now())
  track          Track    @default(ENTREPRENEURSHIP_ECONOMICS)

  @@unique([userId, normalizedDate, track])
  @@index([userId])
}

model UserProgress {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentDay     Int      @default(1)
  streak         Int      @default(0)
  lastActiveDate String?
  totalXP        Int      @default(0)
  hearts         Int      @default(5)
  lastHeartDecay DateTime @default(now())
  dailyTimeGoal  Int      @default(60)
  startDate      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model TrackProgress {
  id         String    @id @default(cuid())
  userId     String
  track      Track
  xp         Int       @default(0)
  currentDay Int       @default(1)
  streak     Int       @default(0)
  lastActive DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, track])
  @@index([userId])
}

model CompletedLesson {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  title     String
  date      DateTime
  xpEarned  Int
  track     Track
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, lessonId, track])
  @@index([userId])
}

model QuizResult {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId   String
  score    Int
  date     DateTime
  xpEarned Int

  track     Track
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, quizId, track])
  @@index([userId])
  @@index([quizId])
  @@index([userId, date])
}

model Lesson {
  id           String @id @default(cuid())
  title        String
  tag          String
  timeEstimate Int
  dayOrder     Int
  track        Track

  conceptText      String?
  conceptSummary   String?
  conceptTakeaways Json?

  articleTitle     String?
  articleText      String?
  articleSummary   String?
  articleTakeaways Json?

  articles          Article[]
  concepts          Concept[]
  agendaCompletions AgendaCompletion[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt

  @@unique([track, dayOrder])
  @@index([tag])
  @@index([track])
}

model Quiz {
  id                String             @id @default(cuid())
  title             String
  tag               String
  timeEstimate      Int
  dayOrder          Int
  track             Track
  agendaCompletions AgendaCompletion[]
  questions         QuizQuestion[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt

  @@unique([track, dayOrder])
  @@index([tag])
  @@index([track])
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText  String
  options       String[]
  correctAnswer String
  explanation   String?
  order         Int      @default(0)

  @@index([quizId])
}

model Article {
  id                String             @id @default(cuid())
  lessonId          String
  lesson            Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  agendaCompletions AgendaCompletion[]
}

model Concept {
  id                String             @id @default(cuid())
  lessonId          String
  lesson            Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  agendaCompletions AgendaCompletion[]
}

model AgendaCompletion {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType       ItemType
  lessonId       String?
  lesson         Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quizId         String?
  quiz           Quiz?    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  articleId      String?
  article        Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  conceptId      String?
  concept        Concept? @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  completedAt    DateTime @default(now())
  normalizedDate DateTime

  @@index([userId])
  @@index([normalizedDate])
  @@index([userId, normalizedDate])
  @@index([userId, lessonId, itemType])
}

model QuizAttempt {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId        String
  questionId    String
  questionText  String?
  isCorrect     Boolean
  userAnswer    String
  correctAnswer String
  explanation   String?
  timestamp     DateTime       @default(now())
  mistakeReview MistakeReview?

  @@index([userId])
  @@index([quizId])
}

model MistakeReview {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  quizAttemptId String      @unique
  quizAttempt   QuizAttempt @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
  reviewed      Boolean     @default(false)
  reviewedAt    DateTime?
  track         Track

  @@index([userId])
  @@index([userId, track])
  @@index([reviewed])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Note {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  lessonId  String?
  content   String    @db.Text
  color     String?
  source    String?
  timestamp DateTime?
  track     Track
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([userId, lessonId, track])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  slug      String
  track     Track
  createdAt DateTime @default(now())

  @@unique([userId, slug, track])
  @@index([userId])
  @@index([userId, slug, track])
}

model LeaderboardRank {
  userId           String  @id
  username         String?
  profileImage     String?
  lessonsCompleted Int
  totalXP          Int
  rank             Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rank])
  @@index([username])
}

// ─── Duel mode ───────────────────────────────────────────────────────────────
// A rated head-to-head ladder. Deliberately separate from the curriculum
// models: nothing here reads or writes lesson progress, so a fault in duel
// code cannot damage a learner's 56-day record.

enum DuelRunStatus {
  /// Played, waiting for a challenger to face the same set.
  OPEN
  /// Paired into a resolved Duel.
  MATCHED
  /// Started and never finished; carries no rating consequence.
  ABANDONED
}

/// The duel question bank, kept apart from QuizQuestion so that duels cannot
/// spoil lessons the player has not reached yet.
model DuelQuestion {
  id            String   @id @default(cuid())
  topic         String
  questionText  String
  options       String[]
  correctAnswer String
  explanation   String?

  /// Filled by real play. Two counters now are what later lets a question's
  /// difficulty be graded from the ratings of the players who answered it.
  timesServed  Int @default(0)
  timesCorrect Int @default(0)

  /// A leaked or broken question is retired without deleting its history.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([topic])
  @@index([active])
}

/// Ten question ids in a fixed order. Whoever plays first creates the set; the
/// challenger is served the identical one, which is what makes the two runs
/// comparable at all.
model DuelSet {
  id          String   @id @default(cuid())
  questionIds String[]
  createdAt   DateTime @default(now())

  runs  DuelRun[]
  duels Duel[]

  @@index([createdAt])
}

/// One player's attempt at one set.
model DuelRun {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  setId  String
  set    DuelSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  /// [{ questionId, chosen, isCorrect, ms }] — only the result screen reads
  /// these, so they stay a document rather than a table in week one.
  answers Json @default("[]")
  score   Int  @default(0)
  totalMs Int  @default(0)

  /// The player's rating when they sat down. Not used to settle the duel —
  /// that reads live ratings — but it is the record calibration needs later.
  ratingBefore Int
  status       DuelRunStatus @default(OPEN)
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?

  duelsAsA Duel[] @relation("DuelRunA")
  duelsAsB Duel[] @relation("DuelRunB")

  /// A player faces a given set once. Enforced here rather than in code so a
  /// race between two tabs cannot produce a second attempt.
  @@unique([userId, setId])
  @@index([status, startedAt])
  @@index([userId])
}

/// A resolved pairing of two runs over the same set.
model Duel {
  id    String  @id @default(cuid())
  setId String
  set   DuelSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  /// Unique on both sides: one run settles one duel, so a lucky round cannot
  /// be farmed for rating against several challengers.
  runAId String  @unique
  runA   DuelRun @relation("DuelRunA", fields: [runAId], references: [id], onDelete: Cascade)
  runBId String  @unique
  runB   DuelRun @relation("DuelRunB", fields: [runBId], references: [id], onDelete: Cascade)

  /// Null is a draw.
  winnerId  String?
  deltaA    Int
  deltaB    Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model PlayerRating {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      @default(1000)
  played    Int      @default(0)
  won       Int      @default(0)
  lost      Int      @default(0)
  drawn     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@index([rating])
}

/// One shared question a day, for the days nobody else is playing.
model DailyAnswer {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The calendar day as YYYY-MM-DD, not a timestamp: "one a day" is a
  /// question about dates, and comparing timestamps would let a player at
  /// 23:59 answer twice within a minute.
  day        String
  questionId String
  chosen     String?
  isCorrect  Boolean  @default(false)
  ms         Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([userId, day])
  @@index([day])
}

// ─── Staff and competitions ──────────────────────────────────────────────────

/// What a delegated admin is allowed to do. An admin may only grant rights
/// they hold themselves, so nobody can promote past their own level.
enum StaffPermission {
  HOST_COMPETITIONS
  MANAGE_QUESTIONS
  MANAGE_ADMINS
}

/// Rights delegated from the owner.
///
/// The owner is not in this table — they are named in ADMIN_EMAILS and always
/// hold everything. Keeping the root outside the database means a mistake made
/// in the interface can never lock the owner out of fixing it.
model Staff {
  userId      String            @id
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions StaffPermission[]
  /// Who granted these, for an audit trail. Not a relation: the granter may
  /// later be deleted, and the record of who did it should outlive them.
  grantedById String?
  note        String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt
}

enum CompetitionStatus {
  /// Open for joining, not yet playing.
  LOBBY
  RUNNING
  ENDED
}

enum CompetitionAccess {
  /// Listed on the competitions page for anyone signed in.
  OPEN
  /// Reachable only by its code.
  LINK
}

model Competition {
  id     String @id @default(cuid())
  /// Short, shareable, unambiguous. Unique so a join code names one event.
  code   String @unique
  title  String
  hostId String
  host   User   @relation("CompetitionHost", fields: [hostId], references: [id], onDelete: Cascade)

  status CompetitionStatus @default(LOBBY)
  access CompetitionAccess @default(OPEN)

  /// Fixed at creation: everyone in one competition answers the same set in
  /// the same order, or the standings compare nothing.
  questionIds        String[]
  topic              String?
  secondsPerQuestion Int      @default(25)

  /// What the room is answering. A quiz is the multiple choice bank; a problem
  /// set is written answers out of `Problem`. One competition is one or the
  /// other: the two are paced differently, and a room that mixed them would
  /// have to explain two clocks at once.
  format          CompetitionFormat @default(QUIZ)
  /// Ids into `Problem`, in the order the host arranged them. Not a relation:
  /// the order is the host's, and a join would return them in the table's.
  problemIds      String[]
  /// One clock for the whole set, in minutes. Null means the host decides when
  /// it ends. Only read for a problem set — a quiz is paced per question.
  durationMinutes Int?
  /// When the marks were last settled. Null while any answer is still waiting
  /// on the model or on the host, which is what the results screen says.
  gradedAt        DateTime?

  /// Whether leaving the page is watched, and what happens when it is. See
  /// lib/compete/focus.ts — this catches the cheap routes and nothing else,
  /// and the host reads a record rather than a verdict.
  focusPolicy    FocusPolicy @default(NONE)
  /// Absences long enough to count that a player may have before the paper
  /// freezes. Only read under the LOCK policy.
  focusAllowance Int         @default(2)

  createdAt DateTime  @default(now())
  startedAt DateTime?
  endedAt   DateTime?

  players CompetitionPlayer[]
  answers CompetitionAnswer[]

  @@index([status, createdAt])
  @@index([hostId])
}

model CompetitionPlayer {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  score      Int       @default(0)
  totalMs    Int       @default(0)
  answered   Int       @default(0)
  joinedAt   DateTime  @default(now())
  finishedAt DateTime?

  /// Every time this player's page lost focus: [{ at, ms }]. A document
  /// rather than a table, the same call DuelRun.answers made — only the
  /// host's record screen reads it, and it is capped in code.
  awayLog    Json      @default("[]")
  /// Kept beside the log so a standings query never has to parse it.
  awayCount  Int       @default(0)
  awayMs     Int       @default(0)
  /// Frozen, not finished. The host can clear this and they carry on from
  /// where they were; nothing they wrote is submitted or lost.
  lockedAt   DateTime?
  /// Why, in words the student reads on the frozen screen. Written by the host
  /// when they stop someone by hand, and by the guard when it stops them
  /// itself. A paper that stops without saying why is how a room ends in an
  /// argument nobody can settle afterwards.
  lockReason String?
  /// Null when the guard did it, the host's id when a person did. The two are
  /// answered differently when a student asks.
  lockedById String?

  /// The verdict after the room ended. Separate from the lock on purpose: a
  /// lock is a pause anyone can lift, and this is a result. Never a delete —
  /// the paper, the marks and the record all stay as the evidence for it.
  disqualifiedAt   DateTime?
  disqualifyReason String?

  @@unique([competitionId, userId])
  @@index([competitionId, score])
}

model CompetitionAnswer {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId    String

  chosen    String?
  /// What was written in the box, for a problem. `chosen` is the quiz's column
  /// and stays null here; keeping them apart means a marker can never mistake
  /// a written answer for a selected option.
  text      String?
  isCorrect Boolean @default(false)
  ms        Int     @default(0)

  /// Marks. A quiz answer is worth one and is settled on submit; a problem is
  /// worth what the host set it at, and may wait for a marker.
  points    Int       @default(0)
  maxPoints Int       @default(1)
  gradedBy  GradedBy  @default(AUTO)
  /// One or two sentences the student reads next to their answer.
  feedback  String?
  gradedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  /// One answer per question per player, enforced here rather than in code so
  /// a double submit cannot score twice.
  @@unique([competitionId, userId, questionId])
  @@index([competitionId])
  @@index([userId])
}

/// A quiz room answers the multiple choice bank; a problem room answers papers.
enum CompetitionFormat {
  QUIZ
  PROBLEMS
}

enum ProblemAnswerKind {
  /// One number, marked against a value and a tolerance.
  NUMERIC
  /// A word or a phrase, marked against a list of accepted spellings.
  SHORT
  /// Working, an argument, a derivation. No key exists.
  OPEN
}

/// Who awards the mark. See lib/compete/problem.ts — the meanings are enforced
/// there, not here.
enum ProblemGrading {
  AUTO
  AI
  HOST
}

/// What a mark on the board is currently resting on.
enum GradedBy {
  /// Written, and nothing has marked it yet. It counts for nothing until
  /// something does, and the results screen says so rather than implying a zero.
  PENDING
  AUTO
  AI
  HOST
}

/// A problem out of a paper.
///
/// Deliberately not part of DuelQuestion. The rated ladder is built on four
/// options, a shuffle and a twenty second clock; a problem fits none of that,
/// and keeping it in a table the duel engine never queries means no later
/// change can serve one into a rated duel by accident.
model Problem {
  id    String @id @default(cuid())
  title String @default("Problem")
  topic String @default("General")

  /// Markdown with `$…$` maths, rendered rather than injected as HTML.
  statement String
  /// A diagram out of the paper: a file under `public/problems/` or https.
  imageUrl  String?

  answerKind       ProblemAnswerKind @default(OPEN)
  numericValue     Float?
  numericTolerance Float             @default(0)
  acceptedAnswers  String[]
  /// Placeholder in the box — "in thousands", "one word".
  answerHint       String?

  /// The worked answer. Read by the model when it marks, and by everyone once
  /// the competition has ended — never before, and never by a player mid-room.
  solution String?

  /// The host's call, per problem. A five mark problem and a one mark problem
  /// in the same set is the whole reason marks are not just a count.
  maxPoints   Int            @default(5)
  gradingMode ProblemGrading @default(HOST)

  /// Nullable so a problem outlives the account that wrote it.
  authorId String?
  author   User?   @relation("ProblemAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  /// A broken problem is retired, never deleted: rooms that used it still
  /// have to review against something.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([topic])
  @@index([active])
  @@index([authorId])
}

/// What happens when someone leaves the page mid-paper.
enum FocusPolicy {
  /// Not watched.
  NONE
  /// Recorded, and the student is told it was seen. Nothing freezes.
  WARN
  /// Recorded, and the paper freezes once the allowance is used up.
  LOCK
}
